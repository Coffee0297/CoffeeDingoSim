# CoffeeDingoSim scene "${scene}" (renode/templates/car.resc.hbs, rendered by server/renode.js)
# monitor :${monitorPort}  SLCAN bridge :${bridgePort}  load bank NDJSON :${bankPort}
# The server starts Renode with only the monitor (-P) and then runs `include @<this file>` over
# telnet, so every error in here comes back on the monitor and lands in the Renode log stream.
# Every @path is absolute: relative paths resolve against the Renode install directory.
# the vehicle bus: each module receives frames one frame time apart, as on a real bus (PacedCANHub.cs)
include @${models}/load_models.py
coffeesim_load "${modelsAnchor}" "PacedCANHub.cs"
emulation CreatePacedCANHub "${hub}"

${machines}

# SLCAN bridge: a peripheral on machine 0 (it needs a machine for its 1 kHz virtual-time injection
# clock). SlcanTcpBridge.cs was compiled by the first machine template (coffeesim_load).
mach set 0
machine LoadPlatformDescriptionFromString "slcanBridge: CAN.SlcanTcpBridge @ sysbus 0x5FFF0000 { port: ${bridgePort} }"
connector Connect sysbus.slcanBridge ${hub}
mach clear

# Quantum ${quantumUs} us (server/renode.js sceneQuantumUs). 1 ms keeps inter-module latency under one CAN cycle
# while the 7-machine barrier stays cheap (~0.55x real time). An idle CPU (ChibiOS idle = WFI to Renode) only
# takes an interrupt at its next sync point, so pin edges land on a quantum-sized grid: scenes with a PWM
# source get 250 us (~0.3x real time, PWM duty within ~1 %). renode/README.md sharp edge 19.
emulation SetGlobalQuantum "${quantum}"
logLevel 2
